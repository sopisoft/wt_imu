<launch>
  <arg name="params_file" default="$(find-pkg-share wt_imu)/config/bwt901bcl.yaml" />
  <arg name="log_level" default="info" />

  <node pkg="wt_imu" exec="wt_imu_node" name="wt_imu" output="screen" args="--ros-args --log-level $(var log_level)">
    <param from="$(var params_file)" />
  </node>
</launch>
